# Enable Rewrite Engine
RewriteEngine On

# ✅ Force HTTPS + non-www (www → non-www, http → https)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://kudajadridrizzle.com/$1 [L,R=301]

# ✅ Special custom redirects (overrides generic rules)
Redirect 301 /blog https://kudajadridrizzle.com/blog
Redirect 301 /blog/ https://kudajadridrizzle.com/blog
Redirect 301 /credit-debit-cards.php https://kudajadridrizzle.com/contact
Redirect 301 /dream-wayanad.php https://kudajadridrizzle.com/tour-packages
Redirect 301 /green-wayanad.php https://kudajadridrizzle.com/tour-packages
Redirect 301 /homestay-awards.php https://kudajadridrizzle.com
Redirect 301 /homestays-in-kalpetta.php https://kudajadridrizzle.com/about
Redirect 301 /vibrant-wayanad.php https://kudajadridrizzle.com/tour-packages
Redirect 301 /wayanad-attractions.php https://kudajadridrizzle.com/wayanad
Redirect 301 /wayanad-tour-booking.php https://kudajadridrizzle.com/contact
Redirect 301 /wayanad-tour-packages.php https://kudajadridrizzle.com/tour-packages

# ✅ Universal .php → extensionless (only if not overridden above)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]
